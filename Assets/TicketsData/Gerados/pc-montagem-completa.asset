    description: Abrir um gabinete da sala de TI
    weight: 1
  - id: instalar-placa-mae
    description: Instalar a placa-mae
    weight: 2
  - id: instalar-ram
    description: Instalar a memoria RAM
    weight: 1
  - id: instalar-cooler
    description: Instalar o cooler
    weight: 1
  - id: instalar-fonte
    description: Instalar a fonte de alimentacao
    weight: 2
  - id: instalar-hd
    description: Instalar o armazenamento
    weight: 1
  - id: fechar-gabinete
    description: Fechar o gabinete
    weight: 1
  - id: posicionar-equipamentos
    description: Levar gabinete, monitor, teclado e mouse ate a mesa da estacao
    weight: 2
  - id: conectar-energia
    description: Conectar a alimentacao do PC e do monitor
    weight: 1
  - id: conectar-video
    description: Conectar o monitor
    weight: 1
  - id: conectar-rede
    description: Conectar o cabo de rede
    weight: 1
  - id: instalar-sistema
